#pragma once

#include <math/mat4.h>

#include <string>

namespace android::renderengine {

// Immutable, frame-local parameters for the optional GLES Prism bring-up scene.
// The render target and eye viewports are derived from DisplaySettings.
struct PrismSceneSettings {
    bool enabled = false;
    bool spatialWindowEnabled = false;
    // Debug-only selection of the Android layer that is lifted into the world-space window.
    // An empty value picks the buffered layer with the largest buffer, so bring-up never depends
    // on a hardcoded name. Matching accepts either the full layer name or the stable name without
    // the "#<sequence>" suffix.
    std::string spatialWindowLayer;
    // World placement of the window in metres, measured along the initial gaze direction (-Z).
    float spatialWindowDistanceMeters = 2.0f;
    float spatialWindowHeightMeters = 0.9f;
    // Hide the flat screen copy of the selected layer once its buffer was really drawn as a
    // world-locked quad, so the same content is not shown twice.
    bool spatialWindowSuppressFlatCopy = true;
    float ipd = 0.064f;
    float fovDegrees = 90.0f;
    float nearPlane = 0.05f;
    float farPlane = 100.0f;
    // Rigid transform from head space to world space. GLES uses its inverse as the view matrix;
    // the per-eye IPD transform remains separate. Debug rotations use column vectors and
    // H = R_yaw * R_pitch * R_roll about +Y, +X, and +Z respectively.
    mat4 headTransform = mat4();
};

} // namespace android::renderengine